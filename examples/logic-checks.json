{
  "schema_version": "lab-instruments.logic-check-spec.v1",
  "checks": [
    {
      "id": "console",
      "kind": "uart",
      "configuration": {
        "channel": 0, "baud": 100000, "data_bits": 8,
        "parity": "none", "stop_bits": 1, "inverted": false
      },
      "expect": { "bytes_hex": "4f4b" }
    },
    {
      "id": "pwm",
      "kind": "pwm",
      "configuration": { "channel": 1, "active_level": "high" },
      "expect": {
        "minimum_cycles": 12,
        "frequency_hz": { "minimum": 124000, "maximum": 126000 },
        "duty_cycle": { "minimum": 0.24, "maximum": 0.26 }
      }
    },
    {
      "id": "sensor",
      "kind": "i2c",
      "configuration": { "scl": 2, "sda": 3, "min_phase_samples": 2 },
      "expect": {
        "transfers": [
          { "address": 72, "direction": "write", "start_condition": "start",
            "end_condition": "repeated_start", "data": [2], "acks": [true, true] },
          { "address": 72, "direction": "read", "start_condition": "repeated_start",
            "end_condition": "stop", "data": [18, 52], "acks": [true, true, false] }
        ]
      }
    },
    {
      "id": "spi",
      "kind": "spi",
      "configuration": {
        "sck": 4, "cs": 5, "mosi": 6, "miso": 7, "mode": 0,
        "word_bits": 8, "bit_order": "msb", "cs_active": "low", "min_phase_samples": 2
      },
      "expect": { "transfers": [ { "mosi": [150, 0], "miso": [53, 255] } ] }
    }
  ]
}
